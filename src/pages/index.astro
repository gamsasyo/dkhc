---
// 루트(/) → /ko/. 공유 링크로 많이 쓰이는 주소라 리다이렉트 페이지에도 미리보기(OG) 정보를 넣음
import { t } from '../lib/i18n';
import { company } from '../lib/company';
export const prerender = true;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = `${base}/ko/`;
const canonical = new URL(to, Astro.site);
const name = t('ko', 'site.name');
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{name}</title>
  <meta name="description" content={company.ko.lead} />
  <meta http-equiv="refresh" content={`0;url=${to}`} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={name} />
  <meta property="og:description" content={company.ko.lead} />
  <meta property="og:site_name" content={name} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:image" content={new URL(`${base}/og-image.png`, Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="400" />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline define:vars={{ to }}>location.replace(to);</script>
</head>
<body><a href={to}>{name}</a></body>
</html>
