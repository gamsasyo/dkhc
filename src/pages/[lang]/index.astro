---
import Base from '../../layouts/Base.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import SearchCombo from '../../components/SearchCombo.astro';
import CategoryTiles from '../../components/CategoryTiles.astro';
import ProductListCard from '../../components/ProductListCard.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import { t, localizePath, isLocale } from '../../lib/i18n';
import { products, getMaker, catalogItems, makersWithProducts } from '../../lib/data';
import { countByCategory } from '../../lib/catalog';
import { company } from '../../lib/company';
export const getStaticPaths = () => ['ko', 'en', 'ja'].map((lang) => ({ params: { lang } }));
const { lang } = Astro.params; if (!isLocale(lang)) return Astro.redirect('/ko/');
const catCounts = countByCategory(catalogItems);
const stats = [
  ['1990', t(lang, 'home.stats.founded')],
  [String(makersWithProducts().length), t(lang, 'home.stats.makers')],
  [String(products.length), t(lang, 'home.stats.products')],
  ['3', t(lang, 'home.stats.languages')],
];
const featured = products.slice(0, 6);
---
<Base title={t(lang, 'site.tagline')} description={company[lang].lead} path="/">
  <section class="relative isolate flex min-h-[70vh] items-center overflow-hidden bg-white">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_80%_at_12%_18%,var(--color-tint-special)_0%,transparent_70%),radial-gradient(45%_60%_at_88%_12%,var(--color-tint-medical)_0%,transparent_70%),radial-gradient(55%_70%_at_75%_95%,var(--color-tint-eco)_0%,transparent_70%)]"></div>
    <div class="pointer-events-none absolute -left-24 top-1/3 -z-10 h-[28rem] w-[28rem] rounded-full bg-tint-special/80 blur-3xl"></div>
    <div class="pointer-events-none absolute -right-32 -top-24 -z-10 h-[30rem] w-[30rem] rounded-full bg-tint-medical/80 blur-3xl"></div>
    <div class="pointer-events-none absolute right-1/4 -bottom-40 -z-10 h-[26rem] w-[26rem] rounded-full bg-tint-eco blur-3xl"></div>
    <div class="pointer-events-none absolute -right-40 bottom-10 -z-10 h-72 w-72 rounded-full bg-brand/5 blur-3xl"></div>
    <Container class="py-20 md:py-28">
      <div class="max-w-3xl">
        <Eyebrow class="text-brand/60">{t(lang, 'home.since')}</Eyebrow>
        <h1 class="mt-4 text-4xl leading-[1.15] md:text-6xl">{t(lang, 'site.tagline')}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">{company[lang].lead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={localizePath(lang, '/products/')}>{t(lang, 'home.viewProducts')}</Button>
          <Button href={localizePath(lang, '/contact/')} variant="secondary">{t(lang, 'nav.contact')}</Button>
        </div>
        <SearchCombo locale={lang} class="mt-10 max-w-xl shadow-card" />
      </div>
    </Container>
  </section>

  <section class="py-section-sm md:py-section">
    <Container>
      <Eyebrow>{t(lang, 'products.eyebrow')}</Eyebrow>
      <h2 class="mt-2 text-3xl">{t(lang, 'products.selectCategory')}</h2>
      <div class="mt-6"><CategoryTiles locale={lang} counts={catCounts} hrefFor={(c) => localizePath(lang, `/products/?cat=${c}`)} /></div>
    </Container>
  </section>

  <section class="bg-surface py-section-sm md:py-section">
    <Container>
      <dl class="grid grid-cols-2 gap-8 md:grid-cols-4">
        {stats.map(([n, label]) => (
          <div>
            <dd class="text-4xl font-bold tracking-tight text-brand md:text-5xl">{n}</dd>
            <dt class="mt-2 text-sm font-medium text-ink-2">{label}</dt>
          </div>
        ))}
      </dl>
    </Container>
  </section>

  <section class="py-section-sm md:py-section">
    <Container>
      <div class="flex items-end justify-between gap-4">
        <div>
          <Eyebrow>{t(lang, 'products.eyebrow')}</Eyebrow>
          <h2 class="mt-2 text-3xl">{t(lang, 'home.featured')}</h2>
        </div>
        <a href={localizePath(lang, '/products/')} class="text-sm font-semibold text-accent">{t(lang, 'home.viewAll')} ›</a>
      </div>
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {featured.map((p) => <ProductListCard locale={lang} product={p} maker={getMaker(p.makerId)!} />)}
      </div>
    </Container>
  </section>

  <section class="bg-surface py-section-sm md:py-section">
    <Container>
      <Eyebrow>{t(lang, 'company.eyebrow')}</Eyebrow>
      <h2 class="mt-2 text-3xl">{t(lang, 'home.clients')}</h2>
      <ClientLogos locale={lang} class="mt-8" />
    </Container>
  </section>

  <section class="bg-brand-deep py-section-sm text-white md:py-section">
    <Container class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-3xl text-white md:text-4xl">{t(lang, 'home.cta.title')}</h2>
        <p class="mt-3 text-white/70">{t(lang, 'home.cta.body')}</p>
      </div>
      <Button href={localizePath(lang, '/contact/')} class="shrink-0">{t(lang, 'nav.contact')}</Button>
    </Container>
  </section>
</Base>
