---
import Base from '../../layouts/Base.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import SearchCombo from '../../components/SearchCombo.astro';
import Logo from '../../components/Logo.astro';
import CategoryTiles from '../../components/CategoryTiles.astro';
import ProductListCard from '../../components/ProductListCard.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import { t, localizePath, isLocale } from '../../lib/i18n';
import { products, getMaker, catalogItems, makersWithProducts } from '../../lib/data';
import { countByCategory } from '../../lib/catalog';
import { company } from '../../lib/company';
export const getStaticPaths = () => ['ko', 'en', 'ja'].map((lang) => ({ params: { lang } }));
const { lang } = Astro.params; if (!isLocale(lang)) return Astro.redirect('/ko/');
const catCounts = countByCategory(catalogItems);
const stats: [string, string, number?][] = [
  ['1990', t(lang, 'home.stats.founded'), 1900], // 0부터 세면 너무 오래 돈다
  [String(makersWithProducts().length), t(lang, 'home.stats.makers')],
  [String(products.length), t(lang, 'home.stats.products')],
  ['3', t(lang, 'home.stats.languages')],
];
const featured = products.slice(0, 6);
---
<Base title={t(lang, 'site.tagline')} description={company[lang].lead} path="/">
  <!-- 히어로: CI 제안서 B-01 — 네이비 단색 밴드 + 흰 글자, 오른쪽에 심볼을 크게 잘라 넣은 슈퍼그래픽 -->
  <section class="relative isolate flex min-h-[70vh] items-center bg-brand text-white">
    <!-- 슈퍼그래픽만 잘라냄 — 섹션 자체를 overflow-hidden 하면 검색창 분야 목록이 잘림 -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <Logo variant="symbol" label="" class="absolute -right-[12%] top-1/2 h-[78%] -translate-y-1/2 text-white opacity-[.07] [--logo-pt:#fff] max-md:hidden" />
    </div>
    <Container class="py-20 md:py-28">
      <div class="max-w-3xl">
        <Eyebrow class="text-white/60">{t(lang, 'home.since')}</Eyebrow>
        <h1 class="mt-4 text-4xl leading-[1.15] text-white md:text-6xl">{t(lang, 'site.tagline')}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/75">{company[lang].lead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={localizePath(lang, '/products/')} variant="secondary">{t(lang, 'home.viewProducts')}</Button>
          <Button href={localizePath(lang, '/contact/')} variant="inverse">{t(lang, 'nav.contact')}</Button>
        </div>
        <SearchCombo locale={lang} class="mt-10 max-w-xl border-transparent" />
      </div>
    </Container>
  </section>

  <section class="py-section-sm md:py-section">
    <Container>
      <div data-reveal>
        <Eyebrow>{t(lang, 'products.eyebrow')}</Eyebrow>
        <h2 class="mt-2 text-3xl">{t(lang, 'products.selectCategory')}</h2>
      </div>
      <div class="mt-6"><CategoryTiles locale={lang} counts={catCounts} hrefFor={(c) => localizePath(lang, `/products/?cat=${c}`)} /></div>
    </Container>
  </section>

  <section class="bg-surface py-section-sm md:py-section">
    <Container>
      <dl class="grid grid-cols-2 gap-8 md:grid-cols-4" data-reveal-group>
        {stats.map(([n, label, from]) => (
          <div>
            <dd class="text-4xl font-bold tracking-tight text-brand md:text-5xl tabular-nums" data-countup={n} data-countup-from={from}>{n}</dd>
            <dt class="mt-2 text-sm font-medium text-ink-2">{label}</dt>
          </div>
        ))}
      </dl>
    </Container>
  </section>

  <section class="py-section-sm md:py-section">
    <Container>
      <div class="flex items-end justify-between gap-4" data-reveal>
        <div>
          <Eyebrow>{t(lang, 'products.eyebrow')}</Eyebrow>
          <h2 class="mt-2 text-3xl">{t(lang, 'home.featured')}</h2>
        </div>
        <a href={localizePath(lang, '/products/')} class="text-sm font-semibold text-accent">{t(lang, 'home.viewAll')} <span class="chev">›</span></a>
      </div>
      <div class="mt-8 grid gap-4 lg:grid-cols-2" data-reveal-group>
        {featured.map((p) => <ProductListCard locale={lang} product={p} maker={getMaker(p.makerId)!} />)}
      </div>
    </Container>
  </section>

  <section class="bg-surface py-section-sm md:py-section">
    <Container>
      <div data-reveal>
        <Eyebrow>{t(lang, 'company.eyebrow')}</Eyebrow>
        <h2 class="mt-2 text-3xl">{t(lang, 'home.clients')}</h2>
      </div>
      <ClientLogos locale={lang} class="mt-8" />
    </Container>
  </section>

  <!-- 문의 CTA: 바로 아래 네이비 푸터와 겹치지 않게 흰 바탕 카드 + 왼쪽 네이비 띠. 문의 버튼과 전화를 함께 -->
  <section class="pt-section-sm md:pt-section"><!-- 아래 여백은 푸터의 mt 가 맡음 -->
    <Container>
      <div class="relative flex flex-col gap-8 overflow-hidden rounded-card border border-line bg-white px-6 py-10 shadow-card md:flex-row md:items-center md:justify-between md:px-12 md:py-14" data-reveal>
        <span aria-hidden="true" class="absolute inset-y-0 left-0 w-1.5 bg-brand"></span>
        <div class="max-w-2xl">
          <h2 class="text-3xl md:text-4xl">{t(lang, 'home.cta.title')}</h2>
          <p class="mt-3 text-lg text-ink-2">{t(lang, 'home.cta.body')}</p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-x-6 gap-y-3">
          <Button href={localizePath(lang, '/contact/')}>{t(lang, 'nav.contact')} <span class="chev">›</span></Button>
          <a href={`tel:${t(lang, 'footer.tel').split('~')[0].replace(/-/g, '')}`} class="py-2 text-base font-semibold text-brand hover:text-accent">Tel {t(lang, 'footer.tel')}</a>
        </div>
      </div>
    </Container>
  </section>
</Base>
