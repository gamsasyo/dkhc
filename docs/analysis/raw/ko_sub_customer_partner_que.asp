function RegChk(privacy, spamcode) {
	var obj = document.regform;
	if(obj.name.value==""){ alert('이름을 입력하세요'); obj.name.focus(); return; }
	if(obj.o_email1.value==""){ alert('이메일을 입력하세요'); obj.o_email1.focus(); return; }
